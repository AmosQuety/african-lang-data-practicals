{"id": "yor-0001", "language": "yor", "text": "Ẹni ò lè ṣe bí alábàárù ní Ọ̀yìngbó, kò lè ṣe bí Adégbòrò l'ọjà Ọba.", "translation_en": "No wealth comes cheap.", "contributor_id": "C101", "region": null, "dialect": null, "date_collected": "2026-09", "source_type": "proverb", "domain": "proverb", "reviewed": true, "reviewer_id": "author2-self", "reviewed_by_independent": false, "source_url": null, "site_name": null, "retrieved_date": null, "source_license": null, "translation_source": null}
{"id": "yor-0002", "language": "yor", "text": "Bọ́rí bá pé nílè, a díre.", "translation_en": "It may take long; there's hope to rise again.", "contributor_id": "C101", "region": null, "dialect": null, "date_collected": "2026-09", "source_type": "proverb", "domain": "proverb", "reviewed": true, "reviewer_id": "author2-self", "reviewed_by_independent": false, "source_url": null, "site_name": null, "retrieved_date": null, "source_license": null, "translation_source": null}
{"id": "yor-0003", "language": "yor", "text": "Ojú kì í pọ́n sí i, kò máa lá.", "translation_en": "No matter the level of suffering, there's better days ahead.", "contributor_id": "C101", "region": null, "dialect": null, "date_collected": "2026-09", "source_type": "proverb", "domain": "proverb", "reviewed": true, "reviewer_id": "author2-self", "reviewed_by_independent": false, "source_url": null, "site_name": null, "retrieved_date": null, "source_license": null, "translation_source": null}
{"id": "yor-0004", "language": "yor", "text": "Bá mi nà ọmọ mi, kó dénú olómo.", "translation_en": "Be careful when people invite you to correct or discipline their loved ones; loyalty can easily shift back against you.", "contributor_id": "C101", "region": null, "dialect": null, "date_collected": "2026-09", "source_type": "proverb", "domain": "proverb", "reviewed": true, "reviewer_id": "author2-self", "reviewed_by_independent": false, "source_url": null, "site_name": null, "retrieved_date": null, "source_license": null, "translation_source": null}
{"id": "yor-0006", "language": "yor", "text": "Ẹnu ti èékáná ńlépa kò roju, bí ó ti ń re ènìyàn bẹ́ẹ̀ lo ń re ara-ọ̀run.", "translation_en": "Persevere through hardships, because your adversary or problem is also wearing down.", "contributor_id": "C101", "region": null, "dialect": null, "date_collected": "2026-09", "source_type": "proverb", "domain": "proverb", "reviewed": true, "reviewer_id": "author2-self", "reviewed_by_independent": false, "source_url": null, "site_name": null, "retrieved_date": null, "source_license": null, "translation_source": null}
{"id": "yor-0007", "language": "yor", "text": "Ilé la ti ǹ kọ́ ẹ̀ṣọ́ ròde.", "translation_en": "Good character and upbringing must be established within the family before displaying it to the world.", "contributor_id": "C101", "region": null, "dialect": null, "date_collected": "2026-09", "source_type": "proverb", "domain": "proverb", "reviewed": true, "reviewer_id": "author2-self", "reviewed_by_independent": false, "source_url": null, "site_name": null, "retrieved_date": null, "source_license": null, "translation_source": null}
{"id": "yor-0008", "language": "yor", "text": "Ilé ọba tó jó, ẹwà ló bù sí.", "translation_en": "Make the best of any tragic or difficult situation; good can come out of adversity.", "contributor_id": "C101", "region": null, "dialect": null, "date_collected": "2026-09", "source_type": "proverb", "domain": "proverb", "reviewed": true, "reviewer_id": "author2-self", "reviewed_by_independent": false, "source_url": null, "site_name": null, "retrieved_date": null, "source_license": null, "translation_source": null}
{"id": "yor-0009", "language": "yor", "text": "Bí àgbàda ò bá gbóná, àgbàdo ò lèè ta.", "translation_en": "Good things do not always come easy; hard work and tough times build success (no pain, no gain).", "contributor_id": "C101", "region": null, "dialect": null, "date_collected": "2026-09", "source_type": "proverb", "domain": "proverb", "reviewed": true, "reviewer_id": "author2-self", "reviewed_by_independent": false, "source_url": null, "site_name": null, "retrieved_date": null, "source_license": null, "translation_source": null}
{"id": "yor-0011", "language": "yor", "text": "Ẹ káàárọ̀.", "translation_en": "Good morning.", "contributor_id": "C101", "region": null, "dialect": null, "date_collected": "2026-09", "source_type": "self-written", "domain": "greetings", "reviewed": true, "reviewer_id": "author2-self", "reviewed_by_independent": false, "source_url": null, "site_name": null, "retrieved_date": null, "source_license": null, "translation_source": null}
{"id": "yor-0012", "language": "yor", "text": "Ẹ káàárọ̀ o. Báwo ni?", "translation_en": "Good morning. How are you?", "contributor_id": "C101", "region": null, "dialect": null, "date_collected": "2026-09", "source_type": "self-written", "domain": "greetings", "reviewed": true, "reviewer_id": "author2-self", "reviewed_by_independent": false, "source_url": null, "site_name": null, "retrieved_date": null, "source_license": null, "translation_source": null}
{"id": "yor-0013", "language": "yor", "text": "Ṣé dáadáa ni, mo wà pẹ̀lú àlàáfíà. Orúkọ mi ni Adé. Kí ni orúkọ ẹ?", "translation_en": "I am fine, I am doing well. My name is Ade. What is your name?", "contributor_id": "C101", "region": null, "dialect": null, "date_collected": "2026-09", "source_type": "self-written", "domain": "greetings", "reviewed": true, "reviewer_id": "author2-self", "reviewed_by_independent": false, "source_url": null, "site_name": null, "retrieved_date": null, "source_license": null, "translation_source": null}
{"id": "yor-0014", "language": "yor", "text": "Orúkọ mi ni Tálà. Nibo lo ti wá?", "translation_en": "My name is Tala. Where do you come from?", "contributor_id": "C101", "region": null, "dialect": null, "date_collected": "2026-09", "source_type": "self-written", "domain": "greetings", "reviewed": true, "reviewer_id": "author2-self", "reviewed_by_independent": false, "source_url": null, "site_name": null, "retrieved_date": null, "source_license": null, "translation_source": null}
{"id": "yor-0015", "language": "yor", "text": "Mo wá láti Èkó. Ọ̀rẹ́ mi ni mí. Ò dabo!", "translation_en": "I am from Lagos. It is nice to meet you. Goodbye!", "contributor_id": "C101", "region": null, "dialect": null, "date_collected": "2026-09", "source_type": "self-written", "domain": "greetings", "reviewed": true, "reviewer_id": "author2-self", "reviewed_by_independent": false, "source_url": null, "site_name": null, "retrieved_date": null, "source_license": null, "translation_source": null}
{"id": "yor-0016", "language": "yor", "text": "Báwo ni ojú ọ̀jọ̀ ṣe rí lónìí?", "translation_en": "How is the weather today?", "contributor_id": "C101", "region": null, "dialect": null, "date_collected": "2026-09", "source_type": "self-written", "domain": "weather", "reviewed": true, "reviewer_id": "author2-self", "reviewed_by_independent": false, "source_url": null, "site_name": null, "retrieved_date": null, "source_license": null, "translation_source": null}
{"id": "yor-0017", "language": "yor", "text": "Ògì àti àkàrà ni mo jẹ ní àárọ̀ yìí.", "translation_en": "I ate beans cake and pap this morning.", "contributor_id": "C101", "region": null, "dialect": null, "date_collected": "2026-09", "source_type": "self-written", "domain": "food", "reviewed": true, "reviewer_id": "author2-self", "reviewed_by_independent": false, "source_url": null, "site_name": null, "retrieved_date": null, "source_license": null, "translation_source": null}
