{"id": "cgg-0001", "language": "cgg", "text": "akasheeshe", "translation_en": "morning", "contributor_id": "C001", "region": null, "dialect": null, "date_collected": "2026-09", "source_type": "self-written", "domain": "greetings", "reviewed": false, "reviewer_id": null, "reviewed_by_independent": false, "source_url": null, "site_name": null, "retrieved_date": null, "source_license": null, "translation_source": null}
{"id": "cgg-0002", "language": "cgg", "text": "ihangwe", "translation_en": "daytime", "contributor_id": "C001", "region": null, "dialect": null, "date_collected": "2026-09", "source_type": "self-written", "domain": "greetings", "reviewed": false, "reviewer_id": null, "reviewed_by_independent": false, "source_url": null, "site_name": null, "retrieved_date": null, "source_license": null, "translation_source": null}
{"id": "cgg-0003", "language": "cgg", "text": "omwabazyo", "translation_en": "evening", "contributor_id": "C001", "region": null, "dialect": null, "date_collected": "2026-09", "source_type": "self-written", "domain": "greetings", "reviewed": false, "reviewer_id": null, "reviewed_by_independent": false, "source_url": null, "site_name": null, "retrieved_date": null, "source_license": null, "translation_source": null}
{"id": "cgg-0004", "language": "cgg", "text": "ekiro", "translation_en": "night", "contributor_id": "C001", "region": null, "dialect": null, "date_collected": "2026-09", "source_type": "self-written", "domain": "greetings", "reviewed": false, "reviewer_id": null, "reviewed_by_independent": false, "source_url": null, "site_name": null, "retrieved_date": null, "source_license": null, "translation_source": null}
{"id": "cgg-0005", "language": "cgg", "text": "Okuramutsya omu kasheeshe", "translation_en": "Greeting in the morning", "contributor_id": "C001", "region": null, "dialect": null, "date_collected": "2026-09", "source_type": "self-written", "domain": "greetings", "reviewed": false, "reviewer_id": null, "reviewed_by_independent": false, "source_url": null, "site_name": null, "retrieved_date": null, "source_license": null, "translation_source": null}
{"id": "cgg-0006", "language": "cgg", "text": "Eego oraire gye", "translation_en": "Yes, you spent the night well", "contributor_id": "C001", "region": null, "dialect": null, "date_collected": "2026-09", "source_type": "self-written", "domain": "greetings", "reviewed": false, "reviewer_id": null, "reviewed_by_independent": false, "source_url": null, "site_name": null, "retrieved_date": null, "source_license": null, "translation_source": null}
{"id": "cgg-0007", "language": "cgg", "text": "Oraire ota?", "translation_en": "How did you spend the night?", "contributor_id": "C001", "region": null, "dialect": null, "date_collected": "2026-09", "source_type": "self-written", "domain": "greetings", "reviewed": false, "reviewer_id": null, "reviewed_by_independent": false, "source_url": null, "site_name": null, "retrieved_date": null, "source_license": null, "translation_source": null}
{"id": "cgg-0008", "language": "cgg", "text": "Ndaire kurungi, shana iwe.", "translation_en": "I spent the night well, and you?", "contributor_id": "C001", "region": null, "dialect": null, "date_collected": "2026-09", "source_type": "self-written", "domain": "greetings", "reviewed": false, "reviewer_id": null, "reviewed_by_independent": false, "source_url": null, "site_name": null, "retrieved_date": null, "source_license": null, "translation_source": null}
{"id": "cgg-0009", "language": "cgg", "text": "Ndaire gye.", "translation_en": "I spent the night well.", "contributor_id": "C001", "region": null, "dialect": null, "date_collected": "2026-09", "source_type": "self-written", "domain": "greetings", "reviewed": false, "reviewer_id": null, "reviewed_by_independent": false, "source_url": null, "site_name": null, "retrieved_date": null, "source_license": null, "translation_source": null}
{"id": "cgg-0010", "language": "cgg", "text": "Osiibire ota sebo?", "translation_en": "How was your day, sir?", "contributor_id": "C001", "region": null, "dialect": null, "date_collected": "2026-09", "source_type": "self-written", "domain": "greetings", "reviewed": false, "reviewer_id": null, "reviewed_by_independent": false, "source_url": null, "site_name": null, "retrieved_date": null, "source_license": null, "translation_source": null}
{"id": "cgg-0011", "language": "cgg", "text": "Nsiibire gye sebo, shana iwe.", "translation_en": "My day has been good, sir, and yours?", "contributor_id": "C001", "region": null, "dialect": null, "date_collected": "2026-09", "source_type": "self-written", "domain": "greetings", "reviewed": false, "reviewer_id": null, "reviewed_by_independent": false, "source_url": null, "site_name": null, "retrieved_date": null, "source_license": null, "translation_source": null}
{"id": "cgg-0012", "language": "cgg", "text": "Nsiibire kurungi.", "translation_en": "My day was good.", "contributor_id": "C001", "region": null, "dialect": null, "date_collected": "2026-09", "source_type": "self-written", "domain": "greetings", "reviewed": false, "reviewer_id": null, "reviewed_by_independent": false, "source_url": null, "site_name": null, "retrieved_date": null, "source_license": null, "translation_source": null}
{"id": "cgg-0013", "language": "cgg", "text": "Omuka baraire gye.", "translation_en": "At home they spent the night well.", "contributor_id": "C001", "region": null, "dialect": null, "date_collected": "2026-09", "source_type": "self-written", "domain": "greetings", "reviewed": false, "reviewer_id": null, "reviewed_by_independent": false, "source_url": null, "site_name": null, "retrieved_date": null, "source_license": null, "translation_source": null}
{"id": "cgg-0014", "language": "cgg", "text": "Omwana ashomire gye?", "translation_en": "Did the child study well?", "contributor_id": "C001", "region": null, "dialect": null, "date_collected": "2026-09", "source_type": "self-written", "domain": "greetings", "reviewed": false, "reviewer_id": null, "reviewed_by_independent": false, "source_url": null, "site_name": null, "retrieved_date": null, "source_license": null, "translation_source": null}
{"id": "cgg-0015", "language": "cgg", "text": "Omwana ashomire kurungi.", "translation_en": "The child studied well.", "contributor_id": "C001", "region": null, "dialect": null, "date_collected": "2026-09", "source_type": "self-written", "domain": "greetings", "reviewed": false, "reviewer_id": null, "reviewed_by_independent": false, "source_url": null, "site_name": null, "retrieved_date": null, "source_license": null, "translation_source": null}
{"id": "cgg-0016", "language": "cgg", "text": "Omuka oine bintu ki omu nju?", "translation_en": "What things do you have at home?", "contributor_id": "C001", "region": null, "dialect": null, "date_collected": "2026-09", "source_type": "self-written", "domain": "greetings", "reviewed": false, "reviewer_id": null, "reviewed_by_independent": false, "source_url": null, "site_name": null, "retrieved_date": null, "source_license": null, "translation_source": null}
{"id": "cgg-0017", "language": "cgg", "text": "Nyine emeeza, ekitabo n'etebe omuka.", "translation_en": "I have a table, a book and a chair at home.", "contributor_id": "C001", "region": null, "dialect": null, "date_collected": "2026-09", "source_type": "self-written", "domain": "greetings", "reviewed": false, "reviewer_id": null, "reviewed_by_independent": false, "source_url": null, "site_name": null, "retrieved_date": null, "source_license": null, "translation_source": null}
{"id": "cgg-0018", "language": "cgg", "text": "Oine emeeza n'entebe?", "translation_en": "Do you have a table and a chair?", "contributor_id": "C001", "region": null, "dialect": null, "date_collected": "2026-09", "source_type": "self-written", "domain": "greetings", "reviewed": false, "reviewer_id": null, "reviewed_by_independent": false, "source_url": null, "site_name": null, "retrieved_date": null, "source_license": null, "translation_source": null}
{"id": "cgg-0019", "language": "cgg", "text": "Eego, nyine emeeza n'entebe.", "translation_en": "Yes, I have a table and a chair.", "contributor_id": "C001", "region": null, "dialect": null, "date_collected": "2026-09", "source_type": "self-written", "domain": "greetings", "reviewed": false, "reviewer_id": null, "reviewed_by_independent": false, "source_url": null, "site_name": null, "retrieved_date": null, "source_license": null, "translation_source": null}
{"id": "cgg-0020", "language": "cgg", "text": "Hati nikoseza computer kuhandiika.", "translation_en": "Now I am using a computer to write.", "contributor_id": "C001", "region": null, "dialect": null, "date_collected": "2026-09", "source_type": "self-written", "domain": "greetings", "reviewed": false, "reviewer_id": null, "reviewed_by_independent": false, "source_url": null, "site_name": null, "retrieved_date": null, "source_license": null, "translation_source": null}
{"id": "cgg-0021", "language": "cgg", "text": "Oriregye sebo?", "translation_en": "Are you well, sir?", "contributor_id": "C001", "region": null, "dialect": null, "date_collected": "2026-09", "source_type": "self-written", "domain": "marketplace", "reviewed": false, "reviewer_id": null, "reviewed_by_independent": false, "source_url": null, "site_name": null, "retrieved_date": null, "source_license": null, "translation_source": null}
{"id": "cgg-0022", "language": "cgg", "text": "Ndiregye sebo, oriregye sebo?", "translation_en": "I am well, sir. Are you well, sir?", "contributor_id": "C001", "region": null, "dialect": null, "date_collected": "2026-09", "source_type": "self-written", "domain": "marketplace", "reviewed": false, "reviewer_id": null, "reviewed_by_independent": false, "source_url": null, "site_name": null, "retrieved_date": null, "source_license": null, "translation_source": null}
{"id": "cgg-0023", "language": "cgg", "text": "Ndigye sebo, shani'we?", "translation_en": "I am fine, sir, and you?", "contributor_id": "C001", "region": null, "dialect": null, "date_collected": "2026-09", "source_type": "self-written", "domain": "marketplace", "reviewed": false, "reviewer_id": null, "reviewed_by_independent": false, "source_url": null, "site_name": null, "retrieved_date": null, "source_license": null, "translation_source": null}
{"id": "cgg-0024", "language": "cgg", "text": "Ndigye.", "translation_en": "I am fine.", "contributor_id": "C001", "region": null, "dialect": null, "date_collected": "2026-09", "source_type": "self-written", "domain": "marketplace", "reviewed": false, "reviewer_id": null, "reviewed_by_independent": false, "source_url": null, "site_name": null, "retrieved_date": null, "source_license": null, "translation_source": null}
{"id": "cgg-0025", "language": "cgg", "text": "Kare, Abomuka bari bata?", "translation_en": "Okay, how is the family?", "contributor_id": "C001", "region": null, "dialect": null, "date_collected": "2026-09", "source_type": "self-written", "domain": "marketplace", "reviewed": false, "reviewer_id": null, "reviewed_by_independent": false, "source_url": null, "site_name": null, "retrieved_date": null, "source_license": null, "translation_source": null}
{"id": "cgg-0026", "language": "cgg", "text": "Barigye.", "translation_en": "They are fine.", "contributor_id": "C001", "region": null, "dialect": null, "date_collected": "2026-09", "source_type": "self-written", "domain": "marketplace", "reviewed": false, "reviewer_id": null, "reviewed_by_independent": false, "source_url": null, "site_name": null, "retrieved_date": null, "source_license": null, "translation_source": null}
{"id": "cgg-0027", "language": "cgg", "text": "Kare, Ninyenda ensenene. Oyineyo ensenene?", "translation_en": "Okay, I want grasshoppers. Do you have grasshoppers?", "contributor_id": "C001", "region": null, "dialect": null, "date_collected": "2026-09", "source_type": "self-written", "domain": "marketplace", "reviewed": false, "reviewer_id": null, "reviewed_by_independent": false, "source_url": null, "site_name": null, "retrieved_date": null, "source_license": null, "translation_source": null}
{"id": "cgg-0028", "language": "cgg", "text": "Orakunda ensenene?", "translation_en": "Do you like grasshoppers?", "contributor_id": "C001", "region": null, "dialect": null, "date_collected": "2026-09", "source_type": "self-written", "domain": "marketplace", "reviewed": false, "reviewer_id": null, "reviewed_by_independent": false, "source_url": null, "site_name": null, "retrieved_date": null, "source_license": null, "translation_source": null}
{"id": "cgg-0029", "language": "cgg", "text": "Ndakunda ensenene munonga!", "translation_en": "I like grasshoppers very much!", "contributor_id": "C001", "region": null, "dialect": null, "date_collected": "2026-09", "source_type": "self-written", "domain": "marketplace", "reviewed": false, "reviewer_id": null, "reviewed_by_independent": false, "source_url": null, "site_name": null, "retrieved_date": null, "source_license": null, "translation_source": null}
{"id": "cgg-0030", "language": "cgg", "text": "Kare! Nyine ensenene.", "translation_en": "Okay! I have grasshoppers.", "contributor_id": "C001", "region": null, "dialect": null, "date_collected": "2026-09", "source_type": "self-written", "domain": "marketplace", "reviewed": false, "reviewer_id": null, "reviewed_by_independent": false, "source_url": null, "site_name": null, "retrieved_date": null, "source_license": null, "translation_source": null}
{"id": "cgg-0031", "language": "cgg", "text": "Kare, ekikopo ky'ensenene ni shiringi zingahi?", "translation_en": "Okay, how much is a cup of grasshoppers?", "contributor_id": "C001", "region": null, "dialect": null, "date_collected": "2026-09", "source_type": "self-written", "domain": "marketplace", "reviewed": false, "reviewer_id": null, "reviewed_by_independent": false, "source_url": null, "site_name": null, "retrieved_date": null, "source_license": null, "translation_source": null}
{"id": "cgg-0032", "language": "cgg", "text": "Enkumi'taano.", "translation_en": "Five thousand.", "contributor_id": "C001", "region": null, "dialect": null, "date_collected": "2026-09", "source_type": "self-written", "domain": "marketplace", "reviewed": false, "reviewer_id": null, "reviewed_by_independent": false, "source_url": null, "site_name": null, "retrieved_date": null, "source_license": null, "translation_source": null}
{"id": "cgg-0033", "language": "cgg", "text": "Kare, oyineyo ebiteete?", "translation_en": "Okay, do you have baskets?", "contributor_id": "C001", "region": null, "dialect": null, "date_collected": "2026-09", "source_type": "self-written", "domain": "marketplace", "reviewed": false, "reviewer_id": null, "reviewed_by_independent": false, "source_url": null, "site_name": null, "retrieved_date": null, "source_license": null, "translation_source": null}
{"id": "cgg-0034", "language": "cgg", "text": "Ingaha, sebo.", "translation_en": "No, sir.", "contributor_id": "C001", "region": null, "dialect": null, "date_collected": "2026-09", "source_type": "self-written", "domain": "marketplace", "reviewed": false, "reviewer_id": null, "reviewed_by_independent": false, "source_url": null, "site_name": null, "retrieved_date": null, "source_license": null, "translation_source": null}
{"id": "cgg-0035", "language": "cgg", "text": "Kare, oyineyo enkoko na zakabegi?", "translation_en": "Okay, do you have chicken and cabbage?", "contributor_id": "C001", "region": null, "dialect": null, "date_collected": "2026-09", "source_type": "self-written", "domain": "marketplace", "reviewed": false, "reviewer_id": null, "reviewed_by_independent": false, "source_url": null, "site_name": null, "retrieved_date": null, "source_license": null, "translation_source": null}
{"id": "cgg-0036", "language": "cgg", "text": "Nyine enkoko emwe na zakabegi ishatu.", "translation_en": "I have one chicken and three cabbages.", "contributor_id": "C001", "region": null, "dialect": null, "date_collected": "2026-09", "source_type": "self-written", "domain": "marketplace", "reviewed": false, "reviewer_id": null, "reviewed_by_independent": false, "source_url": null, "site_name": null, "retrieved_date": null, "source_license": null, "translation_source": null}
{"id": "cgg-0037", "language": "cgg", "text": "Nkoko na zakabegi ni shiringi zingahi?", "translation_en": "How much are the chicken and cabbage?", "contributor_id": "C001", "region": null, "dialect": null, "date_collected": "2026-09", "source_type": "self-written", "domain": "marketplace", "reviewed": false, "reviewer_id": null, "reviewed_by_independent": false, "source_url": null, "site_name": null, "retrieved_date": null, "source_license": null, "translation_source": null}
{"id": "cgg-0038", "language": "cgg", "text": "Emitwaro ebiri.", "translation_en": "Twenty thousand.", "contributor_id": "C001", "region": null, "dialect": null, "date_collected": "2026-09", "source_type": "self-written", "domain": "marketplace", "reviewed": false, "reviewer_id": null, "reviewed_by_independent": false, "source_url": null, "site_name": null, "retrieved_date": null, "source_license": null, "translation_source": null}
{"id": "cgg-0039", "language": "cgg", "text": "Kale. Oyebare munungo. Osiibegye sebo! Ninza kukureeba nyencakare/nyekyakare.", "translation_en": "Okay. Thank you very much. Have a good day, sir! I'll see you tomorrow.", "contributor_id": "C001", "region": null, "dialect": null, "date_collected": "2026-09", "source_type": "self-written", "domain": "marketplace", "reviewed": false, "reviewer_id": null, "reviewed_by_independent": false, "source_url": null, "site_name": null, "retrieved_date": null, "source_license": null, "translation_source": null}
{"id": "cgg-0040", "language": "cgg", "text": "Kale, Osiibegye sebo!", "translation_en": "Okay, have a good day, sir!", "contributor_id": "C001", "region": null, "dialect": null, "date_collected": "2026-09", "source_type": "self-written", "domain": "marketplace", "reviewed": false, "reviewer_id": null, "reviewed_by_independent": false, "source_url": null, "site_name": null, "retrieved_date": null, "source_license": null, "translation_source": null}
{"id": "cgg-0041", "language": "cgg", "text": "Nkaimuka kare omu kasheeshe aka.", "translation_en": "I woke up early this morning.", "contributor_id": "C001", "region": null, "dialect": null, "date_collected": "2026-09", "source_type": "self-written", "domain": "daily-life", "reviewed": false, "reviewer_id": null, "reviewed_by_independent": false, "source_url": null, "site_name": null, "retrieved_date": null, "source_license": null, "translation_source": null}
{"id": "cgg-0042", "language": "cgg", "text": "Nkayogya amaisho gangye kandi naayeyogya ekibuga.", "translation_en": "I washed my face and swept the compound.", "contributor_id": "C001", "region": null, "dialect": null, "date_collected": "2026-09", "source_type": "self-written", "domain": "daily-life", "reviewed": false, "reviewer_id": null, "reviewed_by_independent": false, "source_url": null, "site_name": null, "retrieved_date": null, "source_license": null, "translation_source": null}
{"id": "cgg-0043", "language": "cgg", "text": "Bwanyima nkakora kyayi kandi naarya kyamushansa n'eka yangye.", "translation_en": "Then I made tea and ate breakfast with my family.", "contributor_id": "C001", "region": null, "dialect": null, "date_collected": "2026-09", "source_type": "self-written", "domain": "daily-life", "reviewed": false, "reviewer_id": null, "reviewed_by_independent": false, "source_url": null, "site_name": null, "retrieved_date": null, "source_license": null, "translation_source": null}
{"id": "cgg-0044", "language": "cgg", "text": "Enjura ekagwa munonga nyekiro.", "translation_en": "It rained heavily last night.", "contributor_id": "C001", "region": null, "dialect": null, "date_collected": "2026-09", "source_type": "self-written", "domain": "weather", "reviewed": false, "reviewer_id": null, "reviewed_by_independent": false, "source_url": null, "site_name": null, "retrieved_date": null, "source_license": null, "translation_source": null}
{"id": "cgg-0045", "language": "cgg", "text": "Oruguuto orurikuza omu katare rurimu ebyondo eriizooba.", "translation_en": "The road to the market is muddy today.", "contributor_id": "C001", "region": null, "dialect": null, "date_collected": "2026-09", "source_type": "self-written", "domain": "weather", "reviewed": false, "reviewer_id": null, "reviewed_by_independent": false, "source_url": null, "site_name": null, "retrieved_date": null, "source_license": null, "translation_source": null}
{"id": "cgg-0046", "language": "cgg", "text": "Ninteekateeka ngu eizooba niriija kurugayo nyenkyakare kugira ngu ebijwaro byome.", "translation_en": "I hope the sun comes out tomorrow so the clothes can dry.", "contributor_id": "C001", "region": null, "dialect": null, "date_collected": "2026-09", "source_type": "self-written", "domain": "weather", "reviewed": false, "reviewer_id": null, "reviewed_by_independent": false, "source_url": null, "site_name": null, "retrieved_date": null, "source_license": null, "translation_source": null}
{"id": "cgg-0047", "language": "cgg", "text": "Munyanyowe omuto naaza aha ishomero buri kasheeshe.", "translation_en": "My younger sister goes to school every morning.", "contributor_id": "C001", "region": null, "dialect": null, "date_collected": "2026-09", "source_type": "self-written", "domain": "school", "reviewed": false, "reviewer_id": null, "reviewed_by_independent": false, "source_url": null, "site_name": null, "retrieved_date": null, "source_license": null, "translation_source": null}
{"id": "cgg-0048", "language": "cgg", "text": "Naakunda okubara kwonka naashanga Orungyereza rugumire.", "translation_en": "She likes mathematics but finds English difficult.", "contributor_id": "C001", "region": null, "dialect": null, "date_collected": "2026-09", "source_type": "self-written", "domain": "school", "reviewed": false, "reviewer_id": null, "reviewed_by_independent": false, "source_url": null, "site_name": null, "retrieved_date": null, "source_license": null, "translation_source": null}
{"id": "cgg-0049", "language": "cgg", "text": "Omwegyesa waitu naatuha ekibuuzo eky'okukorera omuka buri izooba.", "translation_en": "Our teacher gives us homework every day.", "contributor_id": "C001", "region": null, "dialect": null, "date_collected": "2026-09", "source_type": "self-written", "domain": "school", "reviewed": false, "reviewer_id": null, "reviewed_by_independent": false, "source_url": null, "site_name": null, "retrieved_date": null, "source_license": null, "translation_source": null}
{"id": "cgg-0050", "language": "cgg", "text": "Taata wangye naahinga ebihimba hamwe na nebitookye omu musiri.", "translation_en": "My father grows beans and matooke in the garden.", "contributor_id": "C001", "region": null, "dialect": null, "date_collected": "2026-09", "source_type": "self-written", "domain": "farming", "reviewed": false, "reviewer_id": null, "reviewed_by_independent": false, "source_url": null, "site_name": null, "retrieved_date": null, "source_license": null, "translation_source": null}
{"id": "cgg-0051", "language": "cgg", "text": "Omu siizoni egi enjura etwire eri nungi, nahabwekyo ebihingwa biriyo nibikura kurungi.", "translation_en": "This season the rain has been good, so the crops are growing well.", "contributor_id": "C001", "region": null, "dialect": null, "date_collected": "2026-09", "source_type": "self-written", "domain": "farming", "reviewed": false, "reviewer_id": null, "reviewed_by_independent": false, "source_url": null, "site_name": null, "retrieved_date": null, "source_license": null, "translation_source": null}
{"id": "cgg-0052", "language": "cgg", "text": "Nitwija kusharuura omu myezi ebiri.", "translation_en": "We will harvest in two months.", "contributor_id": "C001", "region": null, "dialect": null, "date_collected": "2026-09", "source_type": "self-written", "domain": "farming", "reviewed": false, "reviewer_id": null, "reviewed_by_independent": false, "source_url": null, "site_name": null, "retrieved_date": null, "source_license": null, "translation_source": null}
{"id": "cgg-0053", "language": "cgg", "text": "Nyomwebazyo nkataayaayira omunywani ou naabaire ntakareebire omu bwire bureingwa.", "translation_en": "Yesterday I visited a friend I had not seen in a long time.", "contributor_id": "C001", "region": null, "dialect": null, "date_collected": "2026-09", "source_type": "self-written", "domain": "social", "reviewed": false, "reviewer_id": null, "reviewed_by_independent": false, "source_url": null, "site_name": null, "retrieved_date": null, "source_license": null, "translation_source": null}
{"id": "cgg-0054", "language": "cgg", "text": "Tukashutama aheeru kandi twagamba kumara eshaaha nyingi.", "translation_en": "We sat outside and talked for hours.", "contributor_id": "C001", "region": null, "dialect": null, "date_collected": "2026-09", "source_type": "self-written", "domain": "social", "reviewed": false, "reviewer_id": null, "reviewed_by_independent": false, "source_url": null, "site_name": null, "retrieved_date": null, "source_license": null, "translation_source": null}
{"id": "cgg-0055", "language": "cgg", "text": "Ntakagyenzire, akampa obucoori obwokyize kugira ngu ngutware omuka.", "translation_en": "Before I left, she gave me some roasted maize to take home.", "contributor_id": "C001", "region": null, "dialect": null, "date_collected": "2026-09", "source_type": "self-written", "domain": "social", "reviewed": false, "reviewer_id": null, "reviewed_by_independent": false, "source_url": null, "site_name": null, "retrieved_date": null, "source_license": null, "translation_source": null}
{"id": "cgg-0056", "language": "cgg", "text": "Otaine obwengye ashekura omurwabya", "translation_en": "He who lacks wisdom pounds in a cooking clay pot. [meaning: Acting without thought or common sense leads to self-destruction or ruining valuable things.]", "contributor_id": "C001", "region": null, "dialect": null, "date_collected": "2026-09", "source_type": "proverb", "domain": "proverb", "reviewed": false, "reviewer_id": null, "reviewed_by_independent": false, "source_url": null, "site_name": null, "retrieved_date": null, "source_license": null, "translation_source": null}
{"id": "cgg-0057", "language": "cgg", "text": "Ow'akutwara nyekiro omusiima bwasheesha", "translation_en": "He who guides you through the dark night is thanked when morning comes. [meaning: You appreciate a person's help or guidance once you safely see the outcome of a difficult situation.]", "contributor_id": "C001", "region": null, "dialect": null, "date_collected": "2026-09", "source_type": "proverb", "domain": "proverb", "reviewed": false, "reviewer_id": null, "reviewed_by_independent": false, "source_url": null, "site_name": null, "retrieved_date": null, "source_license": null, "translation_source": null}
{"id": "cgg-0058", "language": "cgg", "text": "Oyorora zoona tomanya erahigye", "translation_en": "You feed all the puppies because you do not know which one will hunt best. [meaning: Do not write off any child or person; invest in everyone because you never know who will succeed or help in the future.]", "contributor_id": "C001", "region": null, "dialect": null, "date_collected": "2026-09", "source_type": "proverb", "domain": "proverb", "reviewed": false, "reviewer_id": null, "reviewed_by_independent": false, "source_url": null, "site_name": null, "retrieved_date": null, "source_license": null, "translation_source": null}
{"id": "cgg-0059", "language": "cgg", "text": "Mpora mpora ekahitsya omunyongororwa aha iziba", "translation_en": "Slowly by slowly, the earthworm reached the well. [meaning: Patience, perseverance, and consistency bring ultimate success, much like 'slow and steady wins the race'.]", "contributor_id": "C001", "region": null, "dialect": null, "date_collected": "2026-09", "source_type": "proverb", "domain": "proverb", "reviewed": false, "reviewer_id": null, "reviewed_by_independent": false, "source_url": null, "site_name": null, "retrieved_date": null, "source_license": null, "translation_source": null}
{"id": "cgg-0060", "language": "cgg", "text": "Kamwe kamwe nigwo muganda", "translation_en": "One stick at a time makes the bundle. [meaning: Small, consistent efforts or cooperation lead to accomplishing big goals.]", "contributor_id": "C001", "region": null, "dialect": null, "date_collected": "2026-09", "source_type": "proverb", "domain": "proverb", "reviewed": false, "reviewer_id": null, "reviewed_by_independent": false, "source_url": null, "site_name": null, "retrieved_date": null, "source_license": null, "translation_source": null}
{"id": "cgg-0061", "language": "cgg", "text": "Akati kinikwa kakiri kabisa", "translation_en": "A stick is straightened while it is still young and fresh. [meaning: A person is tamed, taught, or disciplined when they are still young.]", "contributor_id": "C001", "region": null, "dialect": null, "date_collected": "2026-09", "source_type": "proverb", "domain": "proverb", "reviewed": false, "reviewer_id": null, "reviewed_by_independent": false, "source_url": null, "site_name": null, "retrieved_date": null, "source_license": null, "translation_source": null}
{"id": "cgg-0062", "language": "cgg", "text": "Akanyonyi akataragyenda nikagira ngu nyina niwe amanya kuteeka", "translation_en": "A bird that has never traveled thinks its mother is the only one who knows how to cook. [meaning: Exposure expands your worldview. If you never travel or open your mind to new experiences, you will think your own way of living is the only correct one.]", "contributor_id": "C001", "region": null, "dialect": null, "date_collected": "2026-09", "source_type": "proverb", "domain": "proverb", "reviewed": false, "reviewer_id": null, "reviewed_by_independent": false, "source_url": null, "site_name": null, "retrieved_date": null, "source_license": null, "translation_source": null}
{"id": "cgg-0063", "language": "cgg", "text": "Omukazi akaba omunaku tiyehagura", "translation_en": "A woman who was once poor or miserable does not easily forget her past. [meaning: Hard times leave lasting lessons. A person who has truly struggled remains humble, cautious, and deeply appreciative of their success.]", "contributor_id": "C001", "region": null, "dialect": null, "date_collected": "2026-09", "source_type": "proverb", "domain": "proverb", "reviewed": false, "reviewer_id": null, "reviewed_by_independent": false, "source_url": null, "site_name": null, "retrieved_date": null, "source_license": null, "translation_source": null}
{"id": "yor-0001", "language": "yor", "text": "Ẹni ò lè ṣe bí alábàárù ní Ọ̀yìngbó, kò lè ṣe bí Adégbòrò l'ọjà Ọba.", "translation_en": "No wealth comes cheap.", "contributor_id": "C101", "region": null, "dialect": null, "date_collected": "2026-09", "source_type": "proverb", "domain": "proverb", "reviewed": false, "reviewer_id": null, "reviewed_by_independent": false, "source_url": null, "site_name": null, "retrieved_date": null, "source_license": null, "translation_source": null}
{"id": "yor-0002", "language": "yor", "text": "Bọ́rí bá pé nílè, a díre.", "translation_en": "It may take long; there's hope to rise again.", "contributor_id": "C101", "region": null, "dialect": null, "date_collected": "2026-09", "source_type": "proverb", "domain": "proverb", "reviewed": false, "reviewer_id": null, "reviewed_by_independent": false, "source_url": null, "site_name": null, "retrieved_date": null, "source_license": null, "translation_source": null}
{"id": "yor-0003", "language": "yor", "text": "Ojú kì í pọ́n sí i, kò máa lá.", "translation_en": "No matter the level of suffering, there's better days ahead.", "contributor_id": "C101", "region": null, "dialect": null, "date_collected": "2026-09", "source_type": "proverb", "domain": "proverb", "reviewed": false, "reviewer_id": null, "reviewed_by_independent": false, "source_url": null, "site_name": null, "retrieved_date": null, "source_license": null, "translation_source": null}
{"id": "yor-0004", "language": "yor", "text": "Bá mi nà ọmọ mi, kó dénú olómo.", "translation_en": "Be careful when people invite you to correct or discipline their loved ones; loyalty can easily shift back against you.", "contributor_id": "C101", "region": null, "dialect": null, "date_collected": "2026-09", "source_type": "proverb", "domain": "proverb", "reviewed": false, "reviewer_id": null, "reviewed_by_independent": false, "source_url": null, "site_name": null, "retrieved_date": null, "source_license": null, "translation_source": null}
{"id": "yor-0006", "language": "yor", "text": "Ẹnu ti èékáná ńlépa kò roju, bí ó ti ń re ènìyàn bẹ́ẹ̀ lo ń re ara-ọ̀run.", "translation_en": "Persevere through hardships, because your adversary or problem is also wearing down.", "contributor_id": "C101", "region": null, "dialect": null, "date_collected": "2026-09", "source_type": "proverb", "domain": "proverb", "reviewed": false, "reviewer_id": null, "reviewed_by_independent": false, "source_url": null, "site_name": null, "retrieved_date": null, "source_license": null, "translation_source": null}
{"id": "yor-0007", "language": "yor", "text": "Ilé la ti ǹ kọ́ ẹ̀ṣọ́ ròde.", "translation_en": "Good character and upbringing must be established within the family before displaying it to the world.", "contributor_id": "C101", "region": null, "dialect": null, "date_collected": "2026-09", "source_type": "proverb", "domain": "proverb", "reviewed": false, "reviewer_id": null, "reviewed_by_independent": false, "source_url": null, "site_name": null, "retrieved_date": null, "source_license": null, "translation_source": null}
{"id": "yor-0008", "language": "yor", "text": "Ilé ọba tó jó, ẹwà ló bù sí.", "translation_en": "Make the best of any tragic or difficult situation; good can come out of adversity.", "contributor_id": "C101", "region": null, "dialect": null, "date_collected": "2026-09", "source_type": "proverb", "domain": "proverb", "reviewed": false, "reviewer_id": null, "reviewed_by_independent": false, "source_url": null, "site_name": null, "retrieved_date": null, "source_license": null, "translation_source": null}
{"id": "yor-0009", "language": "yor", "text": "Bí àgbàda ò bá gbóná, àgbàdo ò lèè ta.", "translation_en": "Good things do not always come easy; hard work and tough times build success (no pain, no gain).", "contributor_id": "C101", "region": null, "dialect": null, "date_collected": "2026-09", "source_type": "proverb", "domain": "proverb", "reviewed": false, "reviewer_id": null, "reviewed_by_independent": false, "source_url": null, "site_name": null, "retrieved_date": null, "source_license": null, "translation_source": null}
{"id": "yor-0011", "language": "yor", "text": "Ẹ káàárọ̀.", "translation_en": "Good morning.", "contributor_id": "C101", "region": null, "dialect": null, "date_collected": "2026-09", "source_type": "self-written", "domain": "greetings", "reviewed": false, "reviewer_id": null, "reviewed_by_independent": false, "source_url": null, "site_name": null, "retrieved_date": null, "source_license": null, "translation_source": null}
{"id": "yor-0012", "language": "yor", "text": "Ẹ káàárọ̀ o. Báwo ni?", "translation_en": "Good morning. How are you?", "contributor_id": "C101", "region": null, "dialect": null, "date_collected": "2026-09", "source_type": "self-written", "domain": "greetings", "reviewed": false, "reviewer_id": null, "reviewed_by_independent": false, "source_url": null, "site_name": null, "retrieved_date": null, "source_license": null, "translation_source": null}
{"id": "yor-0013", "language": "yor", "text": "Ṣé dáadáa ni, mo wà pẹ̀lú àlàáfíà. Orúkọ mi ni Adé. Kí ni orúkọ ẹ?", "translation_en": "I am fine, I am doing well. My name is Ade. What is your name?", "contributor_id": "C101", "region": null, "dialect": null, "date_collected": "2026-09", "source_type": "self-written", "domain": "greetings", "reviewed": false, "reviewer_id": null, "reviewed_by_independent": false, "source_url": null, "site_name": null, "retrieved_date": null, "source_license": null, "translation_source": null}
{"id": "yor-0014", "language": "yor", "text": "Orúkọ mi ni Tálà. Nibo lo ti wá?", "translation_en": "My name is Tala. Where do you come from?", "contributor_id": "C101", "region": null, "dialect": null, "date_collected": "2026-09", "source_type": "self-written", "domain": "greetings", "reviewed": false, "reviewer_id": null, "reviewed_by_independent": false, "source_url": null, "site_name": null, "retrieved_date": null, "source_license": null, "translation_source": null}
{"id": "yor-0015", "language": "yor", "text": "Mo wá láti Èkó. Ọ̀rẹ́ mi ni mí. Ò dabo!", "translation_en": "I am from Lagos. It is nice to meet you. Goodbye!", "contributor_id": "C101", "region": null, "dialect": null, "date_collected": "2026-09", "source_type": "self-written", "domain": "greetings", "reviewed": false, "reviewer_id": null, "reviewed_by_independent": false, "source_url": null, "site_name": null, "retrieved_date": null, "source_license": null, "translation_source": null}
{"id": "yor-0016", "language": "yor", "text": "Báwo ni ojú ọ̀jọ̀ ṣe rí lónìí?", "translation_en": "How is the weather today?", "contributor_id": "C101", "region": null, "dialect": null, "date_collected": "2026-09", "source_type": "self-written", "domain": "weather", "reviewed": false, "reviewer_id": null, "reviewed_by_independent": false, "source_url": null, "site_name": null, "retrieved_date": null, "source_license": null, "translation_source": null}
{"id": "yor-0017", "language": "yor", "text": "Ògì àti àkàrà ni mo jẹ ní àárọ̀ yìí.", "translation_en": "I ate beans cake and pap this morning.", "contributor_id": "C101", "region": null, "dialect": null, "date_collected": "2026-09", "source_type": "self-written", "domain": "food", "reviewed": false, "reviewer_id": null, "reviewed_by_independent": false, "source_url": null, "site_name": null, "retrieved_date": null, "source_license": null, "translation_source": null}
